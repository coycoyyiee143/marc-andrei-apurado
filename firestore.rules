rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'YeO3hLTVRwan72ZcLk0Tr8gNcXI2';
    }

    match /profile/{profileId} {
      allow read: if profileId == 'main';
      allow create, update, delete: if profileId == 'main' && isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}